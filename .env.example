# Session signing secret (long random string)
SESSION_SECRET=

# Email sending via Resend
RESEND_API_KEY=
MAIL_FROM="html2apk <noreply@yourdomain.com>"

# GitHub OAuth app (Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public URL of this site, e.g. https://html2apk.vercel.app
APP_URL=

# Fine-grained PAT scoped to H3cker01/html2apk-web: Actions (read/write), Contents (read)
GITHUB_DISPATCH_TOKEN=

# Vercel Postgres (set automatically when you link the database)
POSTGRES_URL=
